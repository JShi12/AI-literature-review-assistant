DATABASE_URL=postgresql+psycopg://litreview:litreview@localhost:5432/litreview
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: set this to require a password before the app is usable (e.g. for a public
# deployment). Leave empty for local development -- no login screen when unset.
APP_PASSWORD=
# Optional: set to "true" to disable every action that calls the OpenAI API or writes to the
# database (uploading, extracting claims, generating syntheses/review drafts, backfilling
# metadata). For a public demo deployment seeded with example data, so visitors can browse
# real output without being able to trigger new (billed) API calls. Leave empty locally.
READ_ONLY_DEMO=
